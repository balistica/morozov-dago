<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ .Name }} — {{ .Role }}</title>
<meta name="description" content="{{ .Tagline }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="veil" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<div class="cursor" data-cursor></div>
<div class="cursor-ring" data-cursor-ring></div>
<div class="scroll-rail" aria-hidden="true"><span data-progress></span></div>

<div class="intro" data-intro>
  <div class="intro-core">
    <div class="intro-mark">ДМ</div>
    <div class="intro-bar"><i></i></div>
    <div class="intro-meta"><span>Preparing experience</span><span data-intro-percent>0%</span></div>
  </div>
</div>

<header class="topbar">
  <div class="frame topbar-inner">
    <a class="brand" href="#top">
      <span class="brand-orb"></span>
      <span class="brand-copy">{{ .Name }}<em>{{ .Role }}</em></span>
    </a>
    <nav class="topnav">
      <a href="#about">Профиль</a>
      <a href="#cases">Кейсы</a>
      <a href="#skills">Навыки</a>
      <a href="#experience">Опыт</a>
      <a href="#projects">Проекты</a>
    </nav>
    <div class="topbar-side">
      <span class="live"><i></i>Open to work</span>
      <a class="pill pill-gold" href="#contact">Связаться</a>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="aurora aurora-a"></div>
      <div class="aurora aurora-b"></div>
      <div class="aurora aurora-c"></div>
      <div class="hero-grid"></div>
      <div class="hero-ring ring-a"></div>
      <div class="hero-ring ring-b"></div>
      <div class="hero-ring ring-c"></div>
    </div>

    <div class="frame hero-inner">
      <p class="eyebrow reveal">{{ .Location }} · Portfolio 2027</p>
      <h1 class="mega">
        <span class="mask"><span>{{ .Name }}</span></span>
        <span class="mask"><span>создаёт <i>цифровые</i></span></span>
        <span class="mask"><span>продукты <em>будущего</em></span></span>
      </h1>
      <div class="hero-columns">
        <p class="lead reveal">{{ .Tagline }}</p>
        <div class="hero-side reveal">
          <div class="side-row"><span>Сейчас</span><strong>Открыт к предложениям</strong></div>
          <div class="side-row"><span>Фокус</span><strong>Fullstack · Product · Automation</strong></div>
          <div class="side-row"><span>Стек</span><strong>Laravel · React · Go · Python</strong></div>
        </div>
      </div>
      <div class="hero-actions reveal">
        <a class="button button-primary" href="#cases"><span>Смотреть кейсы</span></a>
        <a class="button button-ghost" href="#contact"><span>Обсудить проект</span></a>
      </div>
    </div>

    <div class="hero-stage" aria-hidden="true">
      <div class="stage-3d" data-tilt-scene>
        <div class="glass-card main-card" data-parallax>
          <div class="card-top"><span>Product engineering</span><span>Live</span></div>
          <div class="card-title">From interface<br><i>to infrastructure</i></div>
          <div class="card-bars"><i></i><i></i><i></i><i></i></div>
          <div class="card-foot"><span>Frontend</span><span>Backend</span><span>DevOps</span><span>QA</span></div>
        </div>
        <div class="glass-card mini-card card-one" data-float="1">
          <span>Production systems</span><strong>12</strong><em>servers</em>
        </div>
        <div class="glass-card mini-card card-two" data-float="2">
          <span>Incident response</span><strong>-30%</strong><em>MTTR</em>
        </div>
        <div class="glass-card mini-card card-three" data-float="3">
          <span>Automated tests</span><strong>40</strong><em>cases</em>
        </div>
      </div>
    </div>
  </section>

  <div class="ribbon" aria-hidden="true">
    <div class="ribbon-track">
      <span>Fullstack development</span><i>◆</i><span>Product interfaces</span><i>◆</i><span>Automation</span><i>◆</i><span>Cloud & DevOps</span><i>◆</i><span>Quality engineering</span><i>◆</i><span>Go · Laravel · React</span><i>◆</i>
      <span>Fullstack development</span><i>◆</i><span>Product interfaces</span><i>◆</i><span>Automation</span><i>◆</i><span>Cloud & DevOps</span><i>◆</i><span>Quality engineering</span><i>◆</i><span>Go · Laravel · React</span><i>◆</i>
    </div>
  </div>

  <section class="section" id="about">
    <div class="frame">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">Profile</p>
          <h2 class="title reveal">Инженерный подход<br><i>к цифровым продуктам</i></h2>
        </div>
        <p class="section-note reveal">Соединяю интерфейс, серверную логику, данные и эксплуатацию. Понимаю, как продукт работает не только в макете, но и в реальной среде.</p>
      </div>
      <div class="about-grid">
        <article class="manifesto reveal" data-tilt>
          <span class="index">01</span>
          <h3>{{ .About }}</h3>
        </article>
        <div class="stat-wall">
          {{ range $index, $stat := .Stats }}
          <div class="stat reveal" data-tilt>
            <strong>{{ $stat.Value }}</strong>
            <span>{{ $stat.Label }}</span>
          </div>
          {{ end }}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="cases">
    <div class="frame">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">Selected cases</p>
          <h2 class="title reveal">Задачи, которые<br>я решал <i>полностью</i></h2>
        </div>
        <p class="section-note reveal">От проблемы и гипотезы до реализации, автоматизации и измеримого результата.</p>
      </div>

      <div class="case-list">
        {{ range $index, $case := .Cases }}
        <article class="case reveal" data-tilt>
          <div class="case-rail">
            <span class="case-number">{{ add $index 1 }}</span>
            <span class="case-line"></span>
          </div>
          <div class="case-body">
            <h3>{{ $case.Title }}</h3>
            <p class="case-problem">{{ $case.Problem }}</p>
            <div class="case-detail">
              <div><h4>Задача</h4><p>{{ $case.Task }}</p></div>
              <div><h4>Решение</h4><ul>{{ range $case.Solution }}<li>{{ . }}</li>{{ end }}</ul></div>
            </div>
            <div class="case-result">
              <h4>Результат</h4>
              <p>{{ $case.Result }}</p>
              {{ if $case.Metrics }}
              <div class="metrics">
                {{ range $case.Metrics }}
                <div><b>{{ .Value }}</b><span>{{ .Label }}</span></div>
                {{ end }}
              </div>
              {{ end }}
            </div>
          </div>
          <div class="case-visual" aria-hidden="true">
            <div class="visual-core">
              <div class="visual-bar"><i></i></div>
              <div class="visual-bar short"><i></i></div>
              <div class="visual-widget"><span>Impact</span><b>Live</b></div>
            </div>
          </div>
        </article>
        {{ end }}
      </div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="frame">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">Capabilities</p>
          <h2 class="title reveal">Навыки<br>и инструменты</h2>
        </div>
        <p class="section-note reveal">Полный цикл: от интерфейса и API до инфраструктуры, наблюдаемости и автоматизации.</p>
      </div>
      <div class="skill-grid">
        {{ range $index, $group := .Skills }}
        <article class="skill reveal" data-tilt>
          <div class="skill-top"><span>{{ add $index 1 }}</span><span>{{ $group.Note }}</span></div>
          <h3>{{ $group.Group }}</h3>
          <ul>
            {{ range $group.Items }}
            <li>
              <span>{{ .Name }}</span>
              <span class="dots">
                {{ range $n := seq 1 5 }}<i class="{{ if le $n .Level }}on{{ end }}"></i>{{ end }}
              </span>
            </li>
            {{ end }}
          </ul>
        </article>
        {{ end }}
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="frame">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">Experience</p>
          <h2 class="title reveal">Опыт<br>и практика</h2>
        </div>
        <p class="section-note reveal">Работа с реальными системами, пользователями, инцидентами, релизами и автоматизацией.</p>
      </div>
      <div class="experience-list">
        {{ range $index, $job := .Experience }}
        <article class="job reveal">
          <div class="job-meta">
            <span>{{ $job.Period }}</span>
            <h3>{{ if $job.Company }}{{ $job.Company }}{{ else }}{{ $job.Role }}{{ end }}</h3>
            {{ if $job.Company }}<p class="job-role">{{ $job.Role }}</p>{{ end }}
          </div>
          <ul>
            {{ range $job.Bullets }}<li>{{ . }}</li>{{ end }}
          </ul>
        </article>
        {{ end }}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="frame">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">Projects</p>
          <h2 class="title reveal">Проекты<br>и системы</h2>
        </div>
        <p class="section-note reveal">Инструменты, автоматизация и продукты, которые делаю для практики и реальных задач.</p>
      </div>
      <div class="project-grid">
        {{ range $index, $project := .Projects }}
        <a class="project reveal" href="{{ $project.URL }}" target="_blank" rel="noopener" data-tilt>
          <span class="project-index">{{ add $index 1 }}</span>
          <h3>{{ $project.Name }}</h3>
          <p>{{ $project.Desc }}</p>
          <div class="project-stack">
            {{ range $project.Stack }}<span>{{ . }}</span>{{ end }}
          </div>
          <span class="project-link">Открыть →</span>
        </a>
        {{ end }}
      </div>
    </div>
  </section>

  <section class="section" id="strengths">
    <div class="frame">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">Strengths</p>
          <h2 class="title reveal">Чем я полезен<br><i>команде</i></h2>
        </div>
      </div>
      <div class="strength-grid">
        {{ range $index, $strength := .Strengths }}
        <article class="strength reveal" data-tilt>
          <span>{{ add $index 1 }}</span>
          <h3>{{ $strength.Title }}</h3>
          <p>{{ $strength.Text }}</p>
        </article>
        {{ end }}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="frame">
      <p class="eyebrow reveal">Contact</p>
      <h2 class="contact-title reveal">Сделаем продукт,<br><i>который работает</i></h2>
      <div class="contact-links reveal">
        {{ range .Links }}
        <a class="button {{ if eq .Label "GitHub" }}button-primary{{ else }}button-ghost{{ end }}" href="{{ .URL }}" target="_blank" rel="noopener"><span>{{ .Label }}</span></a>
        {{ end }}
      </div>
      <p class="contact-note reveal">Расскажите о задаче, продукте и сроках — предложу понятный путь решения.</p>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="frame footer-inner">
    <span>© <span data-year>2027</span> {{ .Name }}</span>
    <span>Built {{ .Built }}</span>
    <a href="#top">Наверх ↑</a>
  </div>
</footer>

<script src="app.js"></script>
</body>
</html>
